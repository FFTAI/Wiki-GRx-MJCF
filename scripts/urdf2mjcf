#!/usr/bin/env python
import os
from sys import stdout
from pathlib import Path

from urdf2mjcf import __version__
from urdf2mjcf.cli import cli
from urdf2mjcf.app import full_pipeline
from urdf2mjcf.core import parse_element as parse_stream, tostring

from lxml import etree


def xml_format(input_file, output_file):
    """
    Format the XML file using lxml
    """
    parser = etree.XMLParser(remove_blank_text=True)
    tree = etree.parse(input_file, parser)

    with open(output_file, 'wb') as f:
        tree.write(
            f,
            pretty_print=True,
            xml_declaration=True,
            encoding='UTF-8',
        )


def app(args):
    """
    App for URDF-2-MJCF conversion
    """

    # Check if the URDF file exists
    urdf_abs_path = os.path.abspath(args.urdf.name)
    mjcf_abs_path = os.path.abspath(args.mjcf.name)

    if not os.path.exists(urdf_abs_path):
        raise FileNotFoundError(f"URDF file not found: {urdf_abs_path}")

    print(f"Input URDF file: {urdf_abs_path}")
    print(f"Output MJCF file: {mjcf_abs_path}")

    # Convert the URDF file to MJCF format
    result = full_pipeline(
        urdf_file_path=urdf_abs_path,
        urdf=parse_stream(args.urdf),
        sensor_config=parse_stream(args.sensor_config),
        mujoco_node=parse_stream(args.mujoco_node),
        default_ground=args.default_ground,
        default_lighting=args.default_lighting,
    )

    # Write the MJCF result to the specified output file
    args.mjcf.write(tostring(result, encoding="unicode"))

    # Close the input and output files
    args.urdf.close()
    args.mjcf.close()

    if args.mujoco_node is not None:
        args.mujoco_node.close()

    if args.sensor_config is not None:
        args.sensor_config.close()

    if args.mjcf != stdout:
        stdout.write(args.mjcf.name)

    # Format the MJCF file
    if args.default_format:
        xml_format(args.mjcf.name, args.mjcf.name)


if __name__ == "__main__":
    # Get default arguments from environment variables
    parser = cli()

    parser.add_argument(
        "--version",
        action="version",
        version=__version__
    )

    args = parser.parse_args()

    app(args)
